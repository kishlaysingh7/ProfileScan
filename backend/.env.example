PORT=4100
NODE_ENV=development
# Comma-separated list of allowed browser origins (the deployed frontend URL in production)
CORS_ORIGIN=http://localhost:5173
# Set to the number of reverse proxies in front of the API (e.g. 1 behind a load balancer)
TRUST_PROXY=0

# Optional – raises GitHub API rate limits (create a fine-grained token with no scopes)
GITHUB_TOKEN=
# Optional – enables web search for LinkedIn/Instagram/Facebook/X/TikTok/YouTube via the Brave Search API
# https://api.search.brave.com/
BRAVE_SEARCH_API_KEY=
# Required for photo-only reverse image search. Results are web pages/images with matching image content.
# https://cloud.google.com/vision/docs/setup
GOOGLE_VISION_API_KEY=
# For public-image URL search through SerpApi Google Lens. It does not accept local file uploads.
SERPAPI_KEY=
# Default matches SerpApi's published free plan. Lower it to reserve part of the quota.
SERPAPI_MONTHLY_LIMIT=250
# Development only: return fixed example.com image-search results without uploading an image to any provider.
MOCK_IMAGE_SEARCH=false
